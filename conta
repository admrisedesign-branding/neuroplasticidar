<script>
(function(){
  const raiz=document.getElementById('ct-raiz');
  const brl=v=>'R$ '+Number(v||0).toFixed(2).replace('.',',');
  const dt=d=>d?new Date(d).toLocaleDateString('pt-BR'):'';
  let feito=false;
  function semLogin(){raiz.innerHTML=`<div class="ct-vazio"><p>Entre com o e-mail que você usou nas compras para ver seus materiais.</p>
      <button class="btn-nav-primary" onclick="openAuth()" style="background:var(--ink);color:#fff;padding:14px 30px;font-size:15px">Entrar</button></div>`;}
  async function tenta(fn){try{return await fn();}catch(e){return null;}}
  async function montar(){
    if(feito)return; feito=true;
    document.getElementById('ct-titulo').textContent='Olá, '+(user.name||'').split(' ')[0];
    raiz.innerHTML='<p style="color:var(--ink-lt);font-weight:300">Buscando seus materiais…</p>';
    const mapa=new Map();
    (purchases||[]).forEach(p=>mapa.set(String(p.id),{id:p.id,title:p.title,file_url:p.file_url,is_free:p.is_free,date:p.date}));
    const u=await tenta(async()=>(await sb.from('users').select('id').eq('email',user.email).maybeSingle()).data);
    if(u&&u.id){
      const comp=await tenta(async()=>(await sb.from('purchases').select('*').eq('user_id',u.id).eq('payment_status','approved')).data)||[];
      comp.filter(c=>c.material_id).forEach(c=>{ if(!mapa.has(String(c.material_id)))mapa.set(String(c.material_id),{id:c.material_id,date:dt(c.created_at)}); });
    }
    mapa.forEach((v,k)=>{const m=materials.find(x=>String(x.id)===k); if(m){v.title=v.title||m.title; v.file_url=v.file_url||m.file_url; v.is_free=(v.is_free!=null)?v.is_free:m.is_free;}});
    const mats=[...mapa.values()];
    const kits=await tenta(async()=>(await sb.from('pedidos_kit').select('*').eq('cliente_email',user.email).order('created_at',{ascending:false})).data)||[];
    const sess=await tenta(async()=>(await sb.from('sessoes_agendadas').select('*').eq('cliente_email',user.email).order('created_at',{ascending:false})).data)||[];
    let h='<div class="ct-bloco"><h2>Meus materiais</h2>';
    h+=mats.length?`<div class="ct-lista">${mats.map(m=>`<div class="ct-item">
        <strong>${m.title||'Material'}</strong>
        <span>${m.is_free?'Gratuito':'Comprado'}${m.date?' · '+m.date:''}</span>
        ${m.file_url&&m.file_url!=='#'?`<a class="baixar" href="${m.file_url}" target="_blank" rel="noopener">Baixar de novo</a>`:'<span>Arquivo sendo preparado — enviamos por e-mail</span>'}
      </div>`).join('')}</div>`
      :`<div class="ct-vazio"><p>Você ainda não baixou nenhum material.</p><a class="btn-claro" href="/materiais/">Ver materiais</a></div>`;
    h+='</div>';
    if(kits.length){h+=`<div class="ct-bloco"><h2>Meus pedidos de kit</h2><div class="ct-lista">${kits.map(k=>`<div class="ct-item">
        <strong>${k.kit_nome||k.nome_kit||'Kit de brinquedos'}</strong>
        <span>Pedido em ${dt(k.created_at)}${(k.valor_total||k.valor)?' · '+brl(k.valor_total||k.valor):''}</span>
        <span class="ct-status">${k.delivery_status||k.status||k.payment_status||'Em andamento'}</span></div>`).join('')}</div></div>`;}
    if(sess.length){h+=`<div class="ct-bloco"><h2>Minhas sessões de orientação</h2><div class="ct-lista">${sess.map(x=>`<div class="ct-item">
        <strong>Orientação ${x.modalidade||''}</strong>
        <span>${x.data_sessao?('Marcada para '+dt(x.data_sessao)):('Solicitada em '+dt(x.created_at))}</span>
        <span class="ct-status">${x.status||x.payment_status||'Aguardando confirmação'}</span></div>`).join('')}</div></div>`;}
    h+='<p style="font-size:14px;color:var(--ink-lt);font-weight:300">Não encontrou algo que comprou? <a href="/contato/" style="color:var(--blue)">Fale com a gente</a> ou chame no WhatsApp.</p>';
    raiz.innerHTML=h;
  }
  let t=0; const iv=setInterval(()=>{t++;
    if(typeof user!=='undefined'&&user&&user.email){ if(materials.length||t>30){clearInterval(iv);montar();} }
    else if(t===12){ semLogin(); }},150);
  setInterval(()=>{ if(!feito&&typeof user!=='undefined'&&user&&user.email){montar();} },1000);
})();
</script>
